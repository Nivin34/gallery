# GEMINI_API_KEY: Required for Gemini AI API calls if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MONGODB_URI: Connection string for MongoDB / MongoDB Atlas.
# When omitted, FolioVault persists collections in a local atomic document store under data/.
MONGODB_URI=

# SESSION_SECRET: Secret key for signing authentication tokens.
SESSION_SECRET=

# STORAGE_DIR: Optional custom directory for object file storage (defaults to ./storage/objects).
STORAGE_DIR=
